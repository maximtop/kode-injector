# Copy this file to .env.1password (gitignored) and replace VAULT_NAME with the
# vault that contains the items documented in scripts/release/ONEPASSWORD.md.
# Resolve the references for one command with:
#   op run --env-file=.env.1password -- make chrome_status
# Values are 1Password secret references, not credentials.

# Item: kode-injector-release; section: Apple Developer ID
APPLE_CERTIFICATE_P12_BASE64=op://VAULT_NAME/kode-injector-release/APPLE_CERTIFICATE_P12_BASE64
APPLE_CERTIFICATE_PASSWORD=op://VAULT_NAME/kode-injector-release/APPLE_CERTIFICATE_PASSWORD
APPLE_DEVELOPER_ID=op://VAULT_NAME/kode-injector-release/APPLE_DEVELOPER_ID
APPLE_NOTARY_KEY_P8_BASE64=op://VAULT_NAME/kode-injector-release/APPLE_NOTARY_KEY_P8_BASE64
APPLE_NOTARY_KEY_ID=op://VAULT_NAME/kode-injector-release/APPLE_NOTARY_KEY_ID
APPLE_NOTARY_ISSUER_ID=op://VAULT_NAME/kode-injector-release/APPLE_NOTARY_ISSUER_ID

# Section: Apple App Store
APPLE_APP_STORE_CERTIFICATE_P12_BASE64=op://VAULT_NAME/kode-injector-release/APPLE_APP_STORE_CERTIFICATE_P12_BASE64
APPLE_APP_STORE_CERTIFICATE_PASSWORD=op://VAULT_NAME/kode-injector-release/APPLE_APP_STORE_CERTIFICATE_PASSWORD
APPLE_APP_STORE_INSTALLER_CERTIFICATE_P12_BASE64=op://VAULT_NAME/kode-injector-release/APPLE_APP_STORE_INSTALLER_CERTIFICATE_P12_BASE64
APP_STORE_CONNECT_API_KEY_P8_BASE64=op://VAULT_NAME/kode-injector-release/APP_STORE_CONNECT_API_KEY_P8_BASE64
APP_STORE_CONNECT_API_KEY_ID=op://VAULT_NAME/kode-injector-release/APP_STORE_CONNECT_API_KEY_ID
APP_STORE_CONNECT_API_ISSUER_ID=op://VAULT_NAME/kode-injector-release/APP_STORE_CONNECT_API_ISSUER_ID

# Section: Chrome Web Store. Only the item ID is project-specific; the Google
# account credentials are shared by every extension and live in the separate
# chrome-web-store-api item.
CHROME_APP_ID=op://VAULT_NAME/kode-injector-release/CHROME_APP_ID
CHROME_CLIENT_ID=op://VAULT_NAME/chrome-web-store-api/CHROME_CLIENT_ID
CHROME_CLIENT_SECRET=op://VAULT_NAME/chrome-web-store-api/CHROME_CLIENT_SECRET
CHROME_REFRESH_TOKEN=op://VAULT_NAME/chrome-web-store-api/CHROME_REFRESH_TOKEN
CHROME_PUBLISHER_ID=op://VAULT_NAME/chrome-web-store-api/CHROME_PUBLISHER_ID

# Section: Edge Add-ons. Only the product IDs are project-specific; the Partner
# Center credentials are shared by every extension and live in the separate
# edge-addons-api item.
EDGE_API_VERSION=v1.1
EDGE_PRODUCT_ID=op://VAULT_NAME/kode-injector-release/EDGE_PRODUCT_ID
EDGE_CLIENT_ID=op://VAULT_NAME/edge-addons-api/EDGE_CLIENT_ID
EDGE_API_KEY=op://VAULT_NAME/edge-addons-api/EDGE_API_KEY
KODE_INJECTOR_EDGE_ID=op://VAULT_NAME/kode-injector-release/KODE_INJECTOR_EDGE_ID

# Section: Firefox AMO. The AMO API credentials belong to the Mozilla account
# and live in the separate firefox-amo-api item.
FIREFOX_AMO_ID=kode-injector
FIREFOX_CLIENT_ID=op://VAULT_NAME/firefox-amo-api/FIREFOX_CLIENT_ID
FIREFOX_CLIENT_SECRET=op://VAULT_NAME/firefox-amo-api/FIREFOX_CLIENT_SECRET

# Section: Product metadata (not secrets and not consumed by every workflow)
APPLE_TEAM_ID=op://VAULT_NAME/kode-injector-release/APPLE_TEAM_ID
APP_STORE_CONNECT_APP_NAME=op://VAULT_NAME/kode-injector-release/APP_STORE_CONNECT_APP_NAME
APP_STORE_CONNECT_BUNDLE_IDENTIFIER=op://VAULT_NAME/kode-injector-release/APP_STORE_CONNECT_BUNDLE_IDENTIFIER
SAFARI_APP_BUNDLE_IDENTIFIER=op://VAULT_NAME/kode-injector-release/SAFARI_APP_BUNDLE_IDENTIFIER
SAFARI_EXTENSION_BUNDLE_IDENTIFIER=op://VAULT_NAME/kode-injector-release/SAFARI_EXTENSION_BUNDLE_IDENTIFIER
FIREFOX_APP_ID=op://VAULT_NAME/kode-injector-release/FIREFOX_APP_ID
