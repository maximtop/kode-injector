{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "experimentalDecorators": true,
        "jsx": "react",
        "types": ["chrome", "node"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.json",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "rspack.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "build",
        "node_modules"
    ]
}
