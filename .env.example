# Store credentials for the local go-webext fallback (make chrome_* and the
# go-webext commands in docs/RELEASE.md). Copy to .env (gitignored) and fill in
# the values. Never commit .env. The same values are stored as GitHub Actions
# secrets and variables for the deploy workflows; see docs/RELEASE.md.

# Chrome Web Store. The item ID is specific to this extension; the other
# values belong to the Google account and are shared by every extension.
CHROME_APP_ID=fgdehkdkmaiedleekbjpfoicpmodbicg
CHROME_PUBLISHER_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Microsoft Edge Add-ons (Publish API v1.1). The product ID is specific to
# this extension; the Client ID and API key belong to the Partner Center
# account.
EDGE_API_VERSION=v1.1
EDGE_PRODUCT_ID=81c5967b-3eee-4964-b3e2-c8a9d138f52e
EDGE_CLIENT_ID=
EDGE_API_KEY=

# Firefox Add-ons (AMO). The listing slug is specific to this extension; the
# JWT credentials belong to the Mozilla account.
FIREFOX_AMO_ID=kode-injector
FIREFOX_CLIENT_ID=
FIREFOX_CLIENT_SECRET=
